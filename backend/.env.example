# --- Application Settings ---
DEBUG=True
APP_NAME="Document Processing API"
FRONTEND_URL="http://localhost:5174"

# --- Security & CORS ---
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# --- Database Settings (Neon PostgreSQL) ---
# Neon provides two connection options:
# 1. POOLED CONNECTION (recommended for serverless/frequent connections)
#    - Use -pooler in hostname (removes channel_binding parameter)
#    - DATABASE_URL_POOLED="postgresql://neondb_owner:ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
#
# 2. DIRECT CONNECTION (recommended for long-running processes)
#    - Use direct hostname (keeps channel_binding parameter)
#    - DATABASE_URL_DIRECT="postgresql://neondb_owner:ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Set DATABASE_URL for backward compatibility, or use DATABASE_URL_POOLED/DATABASE_URL_DIRECT for explicit control.

# Main database URL (can be pooled or direct)
# NOTE: pgbouncer=true is required when using Neon's "-pooler" endpoint with Prisma.
# Without it, Prisma's prepared statements collide across PgBouncer's pooled
# connections under concurrent load (multiple uploads/workers), causing queries
# to hang indefinitely. connection_limit caps how many connections each Prisma
# client (one per request/task) opens against the pool.
DATABASE_URL=""
# Optional: Use these for explicit pooled/direct URL control
# DATABASE_URL_POOLED="postgresql://neondb_owner:"
# DATABASE_URL_DIRECT="postgresql://neondb_owner:"

# --- Redis Settings ---
# NOTE: previously pointed at a Redis Cloud free-tier instance
# (redis-18278.crce292.ap-south-1-2.ec2.cloud.redislabs.com) which has been
# deleted/expired (DNS no longer resolves, even from the host machine).
# Now using the local `redis` service from docker-compose.
# When running docker compose, the `backend`/`worker` services override these
# via their `environment:` block (REDIS_HOST=redis), so this is mainly for
# running the app outside of docker.
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Clerk Authentication ---
CLERK_SECRET_KEY=sk_test_T8cGlL54GyEuEQ1urdqs0EYIjVSldzuHjdeUzfBnEa
# CLERK_FRONTEND_API=your_clerk_frontend_api

# --- Processing Limits ---
# Max upload size in bytes (default 50MB)
MAX_UPLOAD_SIZE=52428800
MAX_FILES_PER_UPLOAD=10
TASK_TIMEOUT=1800
MAX_RETRIES=3

# --- File Storage ---
# Use 'local' for development, 's3' for production
STORAGE_TYPE=s3
LOCAL_STORAGE_PATH="./storage"

# --- AWS S3 (only needed when STORAGE_TYPE=s3) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY="/O"
AWS_S3_BUCKET=""
AWS_REGION=""

# --- Groq Configurations ---
GROQ_API_KEY=""
# Add GROQ_VISION_MAX_PAGES=0 if you want the API to indiscriminately read every single page
# when processing fails locally, or set it to 10 or 5 for your preferred limit.
GROQ_VISION_MAX_PAGES=0

# --- RabbitMQ Settings ---
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
RABBITMQ_VHOST="/"

# --- PostgreSQL Settings (for Docker Compose) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="docproc"